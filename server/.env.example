# Railway injects PORT automatically. Local default is 3000.
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase project settings
SUPABASE_URL=https://rtkyuwaqhnhxcnlitjge.supabase.co
# Use the server-side service-role key only in Railway/local server environment.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Firebase Admin credentials for verifying Firebase Auth ID tokens.
# Paste the complete service-account JSON on one line in Railway.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me"}
